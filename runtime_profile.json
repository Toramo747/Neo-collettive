{
  "schema_version": 1,
  "profile_id": "mycelix-prod-main",
  "deployment_role": "production",
  "repository": "Toramo747/Neo-collettive",
  "branch": "main",
  "state_namespace": "mycelix-prod-main",
  "tracks": {
    "commercial_discovery": {
      "purpose": "Find independently evidenced human buyer problems and qualify them through the unchanged commercial quality gate.",
      "may_consume": [
        "commercial_web_evidence",
        "commercial_evidence_memory"
      ],
      "must_not_consume_as_commercial_evidence": [
        "trust_lab_evaluations",
        "inbound_messages",
        "inbound_agent_stats",
        "seti.signal_memory",
        "runtime_telemetry",
        "ci_control_plane_text"
      ]
    },
    "agent_network": {
      "purpose": "SETI/A2A discovery, inbound interviews and peer coordination.",
      "may_write_commercial_evidence": false,
      "chat_monitor": {
        "enabled": true,
        "records_actual_inbound_and_outbound": true,
        "may_push_without_verified_callback": false,
        "may_write_commercial_evidence": false
      },
      "private_seti_console": {
        "enabled": true,
        "authentication": "NEO_ADMIN_TOKEN",
        "credentials_in_query_string": false,
        "public_snapshot_exposure": false,
        "exposes_private_endpoints": true,
        "exposes_private_interview_responses": true,
        "may_write_commercial_evidence": false
      }
    },
    "trust_lab": {
      "purpose": "Experimental bounded identity/capability/evidence policy evaluation.",
      "may_write_commercial_evidence": false,
      "may_change_commercial_gate": false,
      "intent_discovery": {
        "enabled": true,
        "purpose": "Classify apparent conversational purpose before trust promotion.",
        "may_change_trust_decision": false,
        "may_write_commercial_evidence": false,
        "commercial_intent_is_not_demand_evidence": true
      },
      "agent_demand_observatory": {
        "enabled": true,
        "purpose": "Measure repeated needs across independent inbound agents without treating agent demand as human commercial demand.",
        "independence_unit": "declared_agent_id",
        "anonymous_counts_as_independent": false,
        "thresholds": {
          "anecdote": 1,
          "repeated_signal": 2,
          "emerging_agent_need": 3,
          "strong_pattern": 5
        },
        "may_write_commercial_evidence": false,
        "may_change_commercial_gate": false
      }
    }
  },
  "commercial_gate": {
    "unchanged": true,
    "requirements": [
      "same_concrete_problem",
      "at_least_3_independent_domains_in_21_days",
      "at_least_2_fresh_sources_in_7_days",
      "at_least_1_commercially_strong_buyer_source",
      "PAID_DEMAND_and_BUY_INTENT_or_PAIN"
    ]
  },
  "protected_actions": {
    "spending": false,
    "payments": false,
    "contracts": false,
    "commercial_outreach": false,
    "external_publishing": false,
    "personal_accounts": false
  }
}
