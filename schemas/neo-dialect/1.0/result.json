{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "RESULT"
    },
    "dialect_version": {
      "const": "neo-dialect/1.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agreement_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "summary": {}
  },
  "required": [
    "type",
    "dialect_version",
    "conversation_id",
    "message_id",
    "timestamp",
    "agreement_id",
    "status",
    "summary"
  ],
  "additionalProperties": false,
  "$id": "https://neo-collettive.onrender.com/schemas/neo-dialect/1.0/result.json",
  "title": "neo-dialect/1.0 RESULT"
}
