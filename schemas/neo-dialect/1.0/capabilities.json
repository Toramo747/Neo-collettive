{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "CAPABILITIES"
    },
    "dialect_version": {
      "const": "neo-dialect/1.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "agent_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32
    }
  },
  "required": [
    "type",
    "dialect_version",
    "conversation_id",
    "message_id",
    "timestamp",
    "agent_name",
    "capabilities"
  ],
  "additionalProperties": false,
  "$id": "https://neo-collettive.onrender.com/schemas/neo-dialect/1.0/capabilities.json",
  "title": "neo-dialect/1.0 CAPABILITIES"
}
