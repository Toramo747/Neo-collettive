{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "BYE"
    },
    "dialect_version": {
      "const": "neo-dialect/1.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "status": {
      "enum": [
        "completed",
        "fallback",
        "rejected",
        "closed"
      ]
    }
  },
  "required": [
    "type",
    "dialect_version",
    "conversation_id",
    "message_id",
    "timestamp",
    "reason",
    "status"
  ],
  "additionalProperties": false,
  "$id": "https://neo-collettive.onrender.com/schemas/neo-dialect/1.0/bye.json",
  "title": "neo-dialect/1.0 BYE"
}
