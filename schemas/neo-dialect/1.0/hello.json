      "const": "neo-dialect/1.0"
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "type": "string",
