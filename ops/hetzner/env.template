# /srv/neo/.env  — configurazione e segreti di NEO sul VPS. chmod 600. Mai in git.
# Le righe con <...> vanno riempite. Tutto il resto lo riempie export_render_env.py
# (copia 1:1 delle variabili salvate su Render, tranne quelle di stato, che vanno in envstore).

# ---- dominio e stack -------------------------------------------------------
NEO_DOMAIN=<es. osixbay.it>
# JARVIS_DOMAIN=jarvis.<dominio>      (default)
# STATE_DOMAIN=state.<dominio>        (default)
ACME_EMAIL=<email per i certificati Let's Encrypt>
NEO_PUBLIC_BASE_URL=https://<stesso valore di NEO_DOMAIN>

# generati da install.sh (openssl rand). ENVSTORE_TOKEN fa anche da RENDER_API_KEY per neo.
ENVSTORE_TOKEN=
ENVSTORE_DEPLOY_HOOK=

# ---- valori che su Render erano impostati da render.yaml ---------------------
NEO_MAX_AGENTS=4
NEO_TIMEOUT=25
NEO_SELF_MANAGMENT=true
NEO_AUTOPILOT_INTERVAL_SECONDS=300

# ---- segreti copiati da Render (li scrive export_render_env.py) ---------------
# NEO_ADMIN_TOKEN=            admin API
# NEO_HEARTBEAT_TOKEN=        self-traffic HMAC (stesso valore del secret GitHub)
# NEO_RECEIPT_SIGNING_KEY=    firma ricevute/offerte (se perso, cambia il DID: NON perderlo)
# NEO_STATE_GITHUB_TOKEN=     chunk store nel repo privato
# NEO_STATE_GITHUB_REPO=      owner/name del repo privato
# JARVIS_API_KEY= / JARVIS_SHARED_SECRET=
# MYCELIX_INBOUND_REVIEW_TOKEN= / MYCELIX_ORIGIN_RATE_SALT=
# CANDIDATE_TELEMETRY_HMAC_KEY= / MODEL_CLUSTER_HMAC_KEY=
# BRAVE_SEARCH_API_KEY= / GOOGLE_PSE_KEY= / GOOGLE_PSE_CX= / NEO_SEARCH_PROVIDER=
# GITHUB_TOKEN= / GITHUB_MODELS_TOKEN=
# REDDIT_CLIENT_ID= / REDDIT_CLIENT_SECRET= / REDDIT_REFRESH_TOKEN=
# chiavi x402 / CDP (facilitator, X402_PAY_TO, ...): copiate così come sono su Render

# NON copiare da Render: RENDER_API_KEY, RENDER_SERVICE_ID, JARVIS_RENDER_SERVICE_ID, JARVIS_URL,
# PORT, RENDER_GIT_COMMIT, NEO_STATE_SNAPSHOT_PATH (li imposta docker-compose.yml).
