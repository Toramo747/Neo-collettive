{
  "schema_version":1,
  "name":"production-gate-shaped baseline",
  "positive_markers":{
    "pain":["manual","repetitive","error-prone","backlog","takes hours","spends hours","rework"],
    "buy":["looking for","seeking","needs a tool","wants someone","asks for alternatives","request a quote","requests a quote"],
    "paid":["budget","paid help","contractor","fixed-price","freelancer","hire someone","looking to hire","quote"]
  },
  "negative_markers":["disconfirm","already automated","job vacancy","interview"],
  "negations":["no budget","no paid help","no purchase intent","not looking to hire"],
  "weights":{"pain":2,"buy":3,"paid":4,"negative":4},
  "thresholds":{"demand_score_min":6,"vendor_fp_rate_max":0.0},
  "vendor_exclusion":{"enabled":true,"source_types":["generic_web"],"markers":["free trial","book a demo","book a call","we provide","we offer","hire our","our experts","pricing plans"]}
}
