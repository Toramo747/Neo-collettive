{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycelix-arena-commercial-signal-proposal-v1",
  "title": "MYCELIX Arena commercial signal proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","name","positive_markers","negative_markers","negations","weights","thresholds","vendor_exclusion"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type":"string","minLength":1,"maxLength":80},
    "positive_markers": {
      "type":"object","additionalProperties":false,
      "required":["pain","buy","paid"],
      "properties":{
        "pain":{"$ref":"#/$defs/markerList"},
        "buy":{"$ref":"#/$defs/markerList"},
        "paid":{"$ref":"#/$defs/markerList"}
      }
    },
    "negative_markers": {"$ref":"#/$defs/markerList"},
    "negations": {"$ref":"#/$defs/markerList"},
    "weights": {
      "type":"object","additionalProperties":false,
      "required":["pain","buy","paid","negative"],
      "properties":{
        "pain":{"type":"integer","minimum":0,"maximum":10},
        "buy":{"type":"integer","minimum":0,"maximum":10},
        "paid":{"type":"integer","minimum":0,"maximum":10},
        "negative":{"type":"integer","minimum":0,"maximum":10}
      }
    },
    "thresholds": {
      "type":"object","additionalProperties":false,
      "required":["demand_score_min","vendor_fp_rate_max"],
      "properties":{
        "demand_score_min":{"type":"integer","minimum":1,"maximum":30},
        "vendor_fp_rate_max":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "vendor_exclusion": {
      "type":"object","additionalProperties":false,
      "required":["enabled","source_types","markers"],
      "properties":{
        "enabled":{"type":"boolean"},
        "source_types":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":40}},
        "markers":{"$ref":"#/$defs/markerList"}
      }
    }
  },
  "$defs": {
    "markerList":{
      "type":"array","maxItems":32,"uniqueItems":true,
      "items":{"type":"string","minLength":2,"maxLength":64,"pattern":"^[a-z0-9 _-]+$"}
    }
  }
}
